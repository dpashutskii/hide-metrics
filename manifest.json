{
  "manifest_version": 3,
  "name": "Hide Metrics",
  "version": "1.0.0",
  "description": "Hide views, subscribers, likes, revenue, stats pages and AI prompts on YouTube Studio and YouTube.",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["tabs"],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Hide Metrics",
    "default_popup": "src/popup/popup.html"
  }
}
